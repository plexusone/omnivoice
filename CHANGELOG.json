  "maintainers": ["plexusone", "johncwang@gmail.com"],
  "releases": [
    {
      "version": "v0.7.0",
      "date": "2026-03-22",
      "highlights": [
        { "description": "CallSystem provider registry with Twilio and Telnyx support" },
        { "description": "CallSystemClient for multi-provider management with failover" }
      ],
      "added": [
        { "description": "`CallSystemProviderFactory` type for CallSystem provider creation", "commit": "6c68e8c" },
        { "description": "`RegisterCallSystemProvider` and `GetCallSystemProvider` for runtime provider discovery", "commit": "6c68e8c" },
        { "description": "`ListCallSystemProviders` and `HasCallSystemProvider` to query registered providers", "commit": "6c68e8c" },
        { "description": "Convenience options: `WithAccountSID`, `WithAuthToken`, `WithPhoneNumber`, `WithWebhookURL`, `WithRegion`", "commit": "6c68e8c" },
        { "description": "`CallSystemClient` type alias for multi-provider management with failover", "commit": "ed1cf59" },
        { "description": "`NewCallSystemClient` function to create clients with multiple providers", "commit": "ed1cf59" },
        { "description": "Twilio CallSystem provider registration (requires accountSID, authToken)", "commit": "23449b6" },
        { "description": "Telnyx CallSystem provider registration (requires apiKey)", "commit": "23449b6" }
      ],
      "documentation": [
        { "description": "Add UTF-8 icons to Features section in README", "commit": "60b79f3" },
        { "description": "Add Telnyx to list of supported providers", "commit": "60b79f3" }
      ],
      "dependencies": [
        { "description": "`github.com/plexusone/omnivoice-core` v0.5.0 → v0.6.0", "commit": "0119038" },
        { "description": "`github.com/plexusone/omnivoice-twilio` v0.2.0 → v0.3.0", "commit": "0119038" },
        { "description": "`github.com/plexusone/elevenlabs-go` v0.9.0 → v0.9.1", "commit": "0119038" },
        { "description": "`github.com/plexusone/omnivoice-deepgram` v0.4.0 → v0.4.1", "commit": "0119038" },
        { "description": "`github.com/plexusone/omnivoice-openai` v0.1.0 → v0.1.1", "commit": "0119038" },
        { "description": "Add `github.com/plexusone/omnivoice-telnyx` v0.1.0", "commit": "0119038" }
      ]
    },
    {
      "version": "v0.6.0",
      "date": "2026-03-07",
      "highlights": [
        { "description": "Re-export callsystem types from omnivoice-core for unified imports" }
      ],
      "added": [
        { "description": "`callsystem.go` re-exporting `Call`, `CallSystem`, `CallStatus`, and related types from omnivoice-core", "commit": "33e7ceb" },
        { "description": "`CallHandler`, `CallOptions`, `CallDirection` type aliases", "commit": "33e7ceb" },
        { "description": "`WithFrom`, `WithTimeout`, `WithAgent`, `WithStatusCallback` call options", "commit": "33e7ceb" }
      ],
      "documentation": [
        { "description": "Update README shields", "commit": "e337759" }
      ],
      "dependencies": [
        { "description": "Update omnivoice-core and provider dependencies", "commit": "f4ffd9a" }
      ]
    },
    {
      "version": "v0.5.0",
      "date": "2026-03-01",
      "highlights": [
        { "description": "Batteries-included voice pipeline framework for Go with unified STT and TTS interfaces" },
        { "description": "Provider registry pattern - consumers only need to import omnivoice, not individual provider packages" },
        { "description": "Four providers registered: OpenAI, ElevenLabs, Deepgram, and Twilio" }
      ],
      "added": [
        { "description": "Unified `STTProvider` and `TTSProvider` type aliases re-exported from omnivoice-core", "commit": "545b928" },
        { "description": "`TranscriptionConfig` and `SynthesisConfig` types for provider-agnostic configuration", "commit": "545b928" },
        { "description": "`providers/all` package for importing all providers with a single blank import", "commit": "545b928" },
        { "description": "Provider registry with `RegisterTTSProvider` and `RegisterSTTProvider` for self-registration", "commit": "545b928" },
        { "description": "`GetTTSProvider(name, opts...)` and `GetSTTProvider(name, opts...)` for runtime provider creation", "commit": "545b928" },
        { "description": "`WithAPIKey`, `WithBaseURL`, and `WithExtension` options for provider configuration", "commit": "545b928" },
        { "description": "`ListTTSProviders()` and `ListSTTProviders()` to discover registered providers", "commit": "545b928" },
        { "description": "`HasTTSProvider()` and `HasSTTProvider()` to check provider availability", "commit": "545b928" },
        { "description": "Subtitle generation re-exported from omnivoice-core (`GenerateSRT`, `GenerateVTT`)", "commit": "545b928" }
      ],
      "changed": [
        { "description": "Version v0.5.0 continues from previous omnivoice v0.4.3 (now omnivoice-core) for Go module proxy compatibility" }
      ],
      "build": [
        { "description": "GitHub Actions workflows for CI, linting, and CodeQL security scanning", "commit": "95e8bbb" },
        { "description": "golangci-lint configuration with standard Go linting rules", "commit": "95e8bbb" },
        { "description": "Dependabot configuration for automated dependency updates", "commit": "95e8bbb" }
      ],
      "documentation": [
        { "description": "README with quick start guide, usage examples, and provider compatibility table", "commit": "1f2b810" },
        { "description": "Language codes reference table with BCP-47 examples", "commit": "9835ed7" },
        { "description": "Package documentation with godoc examples", "commit": "66a341b" },
        { "description": "CHANGELOG.json and CHANGELOG.md using structured-changelog format", "commit": "545b928" },
        { "description": "Release notes for v0.5.0", "commit": "545b928" }
      ],
      "dependencies": [
        { "description": "`github.com/plexusone/omnivoice-core` v0.5.0 - Core STT/TTS interfaces", "commit": "545b928" },
        { "description": "`github.com/plexusone/omnivoice-deepgram` v0.4.0 - Deepgram provider", "commit": "545b928" },
        { "description": "`github.com/plexusone/omnivoice-openai` v0.1.0 - OpenAI Whisper/TTS provider", "commit": "545b928" },
        { "description": "`github.com/plexusone/omnivoice-twilio` v0.2.0 - Twilio Media Streams provider", "commit": "545b928" },
        { "description": "`github.com/plexusone/elevenlabs-go` v0.9.0 - ElevenLabs provider", "commit": "545b928" }
      ]
    }
  ]
}
